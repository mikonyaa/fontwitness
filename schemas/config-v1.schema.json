{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "page": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "url": {
          "type": "string",
          "maxLength": 8192,
          "format": "uri"
        },
        "readySelector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "id",
        "url"
      ],
      "additionalProperties": false
    },
    "browser": {
      "default": {
        "headless": true,
        "viewport": {
          "width": 1280,
          "height": 800
        },
        "deviceScaleFactor": 1,
        "locale": "en-US"
      },
      "type": "object",
      "properties": {
        "headless": {
          "default": true,
          "type": "boolean"
        },
        "viewport": {
          "default": {
            "width": 1280,
            "height": 800
          },
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 320,
              "maximum": 3840
            },
            "height": {
              "type": "integer",
              "minimum": 200,
              "maximum": 2160
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "deviceScaleFactor": {
          "default": 1,
          "type": "number",
          "minimum": 0.5,
          "maximum": 3
        },
        "locale": {
          "default": "en-US",
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        }
      },
      "additionalProperties": false
    },
    "readiness": {
      "default": {
        "navigationTimeoutMs": 30000,
        "fontTimeoutMs": 10000,
        "stableWindowMs": 200,
        "maxAttempts": 3,
        "totalTimeoutMs": 90000
      },
      "type": "object",
      "properties": {
        "navigationTimeoutMs": {
          "default": 30000,
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        },
        "fontTimeoutMs": {
          "default": 10000,
          "type": "integer",
          "minimum": 50,
          "maximum": 120000
        },
        "stableWindowMs": {
          "default": 200,
          "type": "integer",
          "minimum": 20,
          "maximum": 5000
        },
        "maxAttempts": {
          "default": 3,
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "totalTimeoutMs": {
          "default": 90000,
          "type": "integer",
          "minimum": 100,
          "maximum": 300000
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "default": {
        "maxTextNodes": 2000,
        "maxMatchesPerRule": 200,
        "maxTextLength": 16384
      },
      "type": "object",
      "properties": {
        "maxTextNodes": {
          "default": 2000,
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxMatchesPerRule": {
          "default": 200,
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "maxTextLength": {
          "default": 16384,
          "type": "integer",
          "minimum": 16,
          "maximum": 65536
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "default": {
        "screenshots": "none",
        "includeText": false
      },
      "type": "object",
      "properties": {
        "screenshots": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "viewport"
          ]
        },
        "includeText": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "preparation": {
      "type": "object",
      "properties": {
        "hook": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "timeoutMs": {
          "default": 10000,
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        }
      },
      "required": [
        "hook"
      ],
      "additionalProperties": false
    },
    "rules": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "selector": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "match": {
            "default": "all",
            "type": "string",
            "const": "all"
          },
          "scope": {
            "default": "subtree",
            "type": "string",
            "enum": [
              "direct",
              "subtree"
            ]
          },
          "minMatches": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          },
          "keyAttribute": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_.:-]*$"
          },
          "allowed": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "familyName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "postScriptName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "isCustomFont": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "required": {
            "default": [],
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "familyName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "postScriptName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "isCustomFont": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "selector"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "page",
    "rules"
  ],
  "additionalProperties": false
}
