{
  "name": "fontwitness",
  "version": "0.1.0",
  "description": "See the fonts Chromium actually renders and enforce typography contracts in CI.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikonyaa/fontwitness.git"
  },
  "homepage": "https://github.com/mikonyaa/fontwitness#readme",
  "bugs": "https://github.com/mikonyaa/fontwitness/issues",
  "bin": {
    "fontwitness": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "schemas",
    "examples/font-loading-site",
    "fixtures/fonts",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "build": "tsc",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "test:package": "node scripts/package-test.mjs",
    "prepack": "npm run build",
    "pretest:unit": "npm run build"
  },
  "dependencies": {
    "commander": "15.0.0",
    "playwright": "1.64.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.1"
  }
}
